<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Corre la captura de Jetstereo cada domingo a las 10:00 a. m. si la Mac está encendida
  (si estaba apagada o dormida, corre al despertar).
  1. Cambia RUTA_DEL_REPO por la carpeta donde clonaste catalogo-tiendas-hn.
  2. cp tools/com.novawebstudio.vitrina-jetstereo.plist ~/Library/LaunchAgents/
  3. launchctl load ~/Library/LaunchAgents/com.novawebstudio.vitrina-jetstereo.plist
  Para quitarlo: launchctl unload ~/Library/LaunchAgents/com.novawebstudio.vitrina-jetstereo.plist
-->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.novawebstudio.vitrina-jetstereo</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>RUTA_DEL_REPO/tools/jetstereo-mac.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key><integer>0</integer>
    <key>Hour</key><integer>10</integer>
    <key>Minute</key><integer>0</integer>
  </dict>
  <key>StandardOutPath</key><string>/tmp/vitrina-jetstereo.log</string>
  <key>StandardErrorPath</key><string>/tmp/vitrina-jetstereo.log</string>
</dict>
</plist>
